{
  "name": "Hisaab — Money Tracker",
  "short_name": "Hisaab",
  "description": "Track expenses, income, transfers, EMIs and budgets across cash, bank, cards and loans.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F1F3F7",
  "theme_color": "#3046C8",
  "categories": ["finance", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Add expense", "short_name": "Add", "url": "./?action=add", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Add from SMS", "short_name": "SMS", "url": "./?action=sms", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
